{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    }
  ],
  "redirects": [
    {
      "source": "/coach",
      "destination": "/coaches",
      "permanent": false
    },
    {
      "source": "/games",
      "destination": "/app/play",
      "permanent": false
    },
    {
      "source": "/play",
      "destination": "/app/play",
      "permanent": false
    }
  ]
}
